; ==============================================================================
; BABA MILK - PJSIP CONFIGURATION FOR META WHATSAPP BUSINESS CALLING
; Meta domain: wa.meta.vc
; Transport: TLS on port 5061 with Let's Encrypt Certificate
; Media: WebRTC standard (DTLS-SRTP + ICE) with OPUS Codec
; ==============================================================================

; --- Global Configuration ---
[global]
type=global
user_agent=BabaMilk-Asterisk-SIP

; --- TLS Transport Configuration ---
[transport-tls]
type=transport
protocol=tls
bind=0.0.0.0:5061
external_media_address=72.61.236.190
external_signaling_address=72.61.236.190
cert_file=/etc/letsencrypt/live/{{SIP_DOMAIN}}/fullchain.pem
priv_key_file=/etc/letsencrypt/live/{{SIP_DOMAIN}}/privkey.pem
method=tlsv1_2
verify_client=no
verify_server=no
allow_reload=yes

; --- WhatsApp / Meta Inbound Endpoint ---
[whatsapp-inbound]
type=endpoint
transport=transport-tls
context=whatsapp-calling
disallow=all
allow=opus
allow=alaw
allow=ulaw
direct_media=no
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes
ice_support=yes
use_avpf=yes
media_encryption=dtls
dtls_verify=no
dtls_cert_file=/etc/letsencrypt/live/{{SIP_DOMAIN}}/fullchain.pem
dtls_private_key=/etc/letsencrypt/live/{{SIP_DOMAIN}}/privkey.pem
dtls_setup=actpass
dtls_fingerprint=SHA-256
dtls_auto_generate_cert=no
dtls_rekey=0

; Identify Meta incoming calls by IP / Domain (wa.meta.vc)
[whatsapp-identify]
type=identify
endpoint=whatsapp-inbound
match=wa.meta.vc
match_header=From: /.*@wa\.meta\.vc/

; Alternative fallback identify by domain header
[whatsapp-identify-domain]
type=identify
endpoint=whatsapp-inbound
match_header=From: /.*@{{SIP_DOMAIN}}/
